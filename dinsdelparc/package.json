{
  "name": "dinsdelparc",
  "private": true,
  "version": "0.1.0",
  "description": "DinsDelParc — plataforma independent per a visitants i aficionats de PortAventura World (no oficial).",
  "workspaces": [
    "apps/*",
    "packages/*"
