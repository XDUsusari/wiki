# Public values only — they are embedded in the app bundle.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: MapLibre style URL (defaults to OpenFreeMap "liberty", OSM data).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Optional: EAS project id for push notifications.
EAS_PROJECT_ID=
