# Copia aquest fitxer a .env.local i omple els valors del teu projecte Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Només al servidor (mai al client). Necessària per esborrar comptes.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Compte root (només per a `npm run create-root`)
ROOT_EMAIL=root@el-teu-domini.cat
# ROOT_PASSWORD=   # opcional; si es deixa buit se'n genera una d'aleatòria
